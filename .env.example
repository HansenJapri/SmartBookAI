# Salin file ini menjadi ".env" lalu isi dengan nilai dari project Supabase Anda
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...isi-anon-public-key-disini

# Verifikasi OTP SMS (telepon). Biarkan false sampai provider SMS (Twilio) dipasang di Supabase.
VITE_PHONE_OTP=false

# (Opsional) Untuk fitur AI kategori/OCR via Claude.
# Dipakai oleh Supabase Edge Function "categorize" (server-side), BUKAN di frontend.
# Set di: Supabase Dashboard → Edge Functions → Secrets
# ANTHROPIC_API_KEY=sk-ant-...
